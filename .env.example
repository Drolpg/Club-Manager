# Copie para .env e troque os valores. O .env nunca vai para o git.
POSTGRES_DB=clubmanager
POSTGRES_USER=clubmanager
POSTGRES_PASSWORD=troque-esta-senha
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8080
# Servidor SMTP: smtp://usuario:senha@host:587 ou smtps://usuario:senha@host:465.
# Vazio: os e-mails saem no log da api e do worker. Em desenvolvimento (docker compose up), o
# compose.override.yaml envia tudo para o Mailpit, em http://localhost:8025, e ignora esta variável.
EMAIL_URL=
DEFAULT_FROM_EMAIL=Club Manager <nao-responda@localhost>
# ID de cliente do Google (docs/setup/google.md). Vazio: o login com Google fica desligado.
GOOGLE_CLIENT_ID=
WEB_PORT=8080
IMAGE_TAG=dev
